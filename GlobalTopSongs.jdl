// GlobalTopsongs entity
entity GlobalTopsongs {
  id Long required,
  songTitle String required unique,
  artistName String required,
  playCount Integer required min(0),
  monthYear Instant required,
  year Integer required min(2000) max(2100)
}

// Define DTOs and service layer
dto GlobalTopsongs with mapstruct
service GlobalTopsongs with serviceClass
paginate GlobalTopsongs with pagination
