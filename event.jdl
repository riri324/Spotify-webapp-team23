@dto(mapstruct)
@service(serviceClass)
@paginate(infinite-scroll)
@filter
entity Event {
  id Integer required unique minlength(5),
  datetime Instant required,
  description String maxlength(500),
  title String,
  venueName String,
  city String,
  region String,
  country String
}

entity Artist {
}

relationship ManyToOne {
  Event{artist} to Artist
}
